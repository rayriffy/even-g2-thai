+// Locally supplied firmware that is intentionally allowed only through the
+// charging-case writer. These pins are independent of the hosted catalog: a
+// local file must match the whole-bundle and Apollo-main digests below.
+
+export const LOCAL_G2_TEMPLE_FLASH_TARGETS = Object.freeze([
+  Object.freeze({
+    imageSha256: "714722cb65f4ef008f8e76d1616da9840f07b0c1dff4bbfbc57a2e7982a679a1",
+    mainSha256: "db476bd9c90483095fbb2ae13ffbe3890544c4d5042057d6280c87b98a87e80d",
+    mainBytes: 3826870,
+    version: "2.2.9.22",
+    reportedVersion: "2.2.9.22",
+    label: "Thai G2 2.2.9.22 · 2005_iannnnnAMD · local Case USB only",
+    hardwareValidated: false,
+    localOnly: true,
+    baseVersion: "2.2.9.22",
+    capabilities: [
+      "Uses the stock G2 2.2.9.22 container with a Thai SARA AM tone-mark positioning patch.",
+      "Accepted only through the charging-case USB writer; direct Bluetooth update remains blocked.",
+      "Hash-pinned and structurally verified, but not yet validated by a Case-USB hardware transfer.",
+    ],
+  }),
+]);
